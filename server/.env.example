# ============================================
# Variables de entorno para el BACKEND (server)
# ============================================

# Conexión a PostgreSQL (Prisma)
# Local:      postgresql://postgres:tu_contraseña@localhost:5433/classboard_db?schema=public
# Producción: La proporciona Railway/Neon/Supabase automáticamente
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/basededatos?schema=public"

# JWT (Autenticación)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# Servidor
PORT=3000
NODE_ENV=development

# CORS - URL del frontend
# Local:      http://localhost:5173
# Producción: https://tu-app.vercel.app
CLIENT_URL=http://localhost:5173
